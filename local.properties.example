# This is a template for local.properties, which is excluded from Git.
# Local Android builds are optional; GitHub Actions is the authoritative release builder.
# Never put real signing values in a tracked file.

# Android SDK path for a local build.
# sdk.dir=/absolute/path/to/Android/Sdk

# Dedicated minibile PKCS#12 release signer. All four values are required together.
# RELEASE_STORE_FILE=/absolute/path/to/minibile-release.jks
# RELEASE_STORE_PASSWORD=
# RELEASE_KEY_ALIAS=minibile-release
# RELEASE_KEY_PASSWORD=
